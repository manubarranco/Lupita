{
  "id": "brutalista",
  "name": "Brutalista",
  "blurb": "Neobrutalismo: tarjeta limón con trazo negro de 3 pt, esquinas redondeadas y sombra negra dura, sin desenfoque. Avenir Next en los títulos, Helvetica Neue en el texto y PT Mono en los datos. Los detalles, planos en menta, salmón y lavanda. En oscuro la tarjeta sigue de color y la sombra se vuelve lavanda. Jerarquía por peso, no por gris.",
  "axes": [
    "type",
    "color",
    "shape",
    "space",
    "shadow"
  ],
  "overrides": {
    "primitive": {
      "font": {
        "family": {
          "heading": {
            "primary": "Avenir Next",
            "fallback": "default"
          },
          "body": {
            "primary": "Helvetica Neue",
            "fallback": "default"
          },
          "code": {
            "primary": "PT Mono",
            "fallback": "monospaced"
          }
        }
      },
      "palette": {
        "brutalista-surface-light": "#FDFD96",
        "brutalista-surface-dark": "#ECE47C",
        "brutalista-notice-surface-light": "#FDFD96",
        "brutalista-notice-surface-dark": "#ECE47C",
        "brutalista-border-light": "#000000",
        "brutalista-border-dark": "#000000",
        "brutalista-text-primary-light": "#000000",
        "brutalista-text-primary-dark": "#000000",
        "brutalista-text-secondary-light": "#2B2B2B",
        "brutalista-text-secondary-dark": "#2B2B2B",
        "brutalista-text-accent-light": "#4B1FC2",
        "brutalista-text-accent-dark": "#4B1FC2",
        "brutalista-badge-bg-light": "#A7DBD8",
        "brutalista-badge-bg-dark": "#A7DBD8",
        "brutalista-badge-fg-light": "#000000",
        "brutalista-badge-fg-dark": "#000000",
        "brutalista-origin-bg-light": "#FFA07A",
        "brutalista-origin-bg-dark": "#FFA07A",
        "brutalista-origin-fg-light": "#000000",
        "brutalista-origin-fg-dark": "#000000",
        "brutalista-swatch-border-light": "#000000",
        "brutalista-swatch-border-dark": "#000000",
        "brutalista-row-hover-light": "#C4A1FF",
        "brutalista-row-hover-dark": "#C4A1FF",
        "brutalista-shadow-light": "#000000",
        "brutalista-shadow-dark": "#C4A1FF",
        "brutalista-shadow-edge-light": "#000000",
        "brutalista-shadow-edge-dark": "#C4A1FF"
      },
      "shadow": {
        "hard": [
          {
            "x": 5,
            "y": 5,
            "blur": 0,
            "spread": 0,
            "color": "{color.shadow}"
          }
        ]
      }
    },
    "semantic": {
      "text": {
        "title": {
          "weight": "{font.weight.bold}",
          "lineHeight": 1.25
        },
        "id": {
          "weight": "{font.weight.bold}",
          "color": "{color.text-primary}"
        },
        "description": {
          "weight": "{font.weight.medium}",
          "color": "{color.text-primary}",
          "lineHeight": 1.4
        },
        "placeholder": {
          "weight": "{font.weight.medium}"
        },
        "repo": {
          "weight": "{font.weight.bold}"
        },
        "location": {
          "color": "{color.text-primary}"
        },
        "badge": {
          "weight": "{font.weight.bold}"
        },
        "eyebrow": {
          "weight": "{font.weight.bold}",
          "color": "{color.text-primary}"
        },
        "footnote": {
          "weight": "{font.weight.medium}",
          "color": "{color.text-primary}"
        },
        "swatch": {
          "color": "{color.text-primary}"
        },
        "notice": {
          "weight": "{font.weight.bold}",
          "color": "{color.text-primary}"
        }
      },
      "color": {
        "surface": {
          "light": "{palette.brutalista-surface-light}",
          "dark": "{palette.brutalista-surface-dark}"
        },
        "notice-surface": {
          "light": "{palette.brutalista-notice-surface-light}",
          "dark": "{palette.brutalista-notice-surface-dark}"
        },
        "border": {
          "light": "{palette.brutalista-border-light}",
          "dark": "{palette.brutalista-border-dark}"
        },
        "text-primary": {
          "light": "{palette.brutalista-text-primary-light}",
          "dark": "{palette.brutalista-text-primary-dark}"
        },
        "text-secondary": {
          "light": "{palette.brutalista-text-secondary-light}",
          "dark": "{palette.brutalista-text-secondary-dark}"
        },
        "text-accent": {
          "light": "{palette.brutalista-text-accent-light}",
          "dark": "{palette.brutalista-text-accent-dark}"
        },
        "badge-bg": {
          "light": "{palette.brutalista-badge-bg-light}",
          "dark": "{palette.brutalista-badge-bg-dark}"
        },
        "badge-fg": {
          "light": "{palette.brutalista-badge-fg-light}",
          "dark": "{palette.brutalista-badge-fg-dark}"
        },
        "origin-bg": {
          "light": "{palette.brutalista-origin-bg-light}",
          "dark": "{palette.brutalista-origin-bg-dark}"
        },
        "origin-fg": {
          "light": "{palette.brutalista-origin-fg-light}",
          "dark": "{palette.brutalista-origin-fg-dark}"
        },
        "swatch-border": {
          "light": "{palette.brutalista-swatch-border-light}",
          "dark": "{palette.brutalista-swatch-border-dark}"
        },
        "row-hover": {
          "light": "{palette.brutalista-row-hover-light}",
          "dark": "{palette.brutalista-row-hover-dark}"
        },
        "shadow": {
          "light": "{palette.brutalista-shadow-light}",
          "dark": "{palette.brutalista-shadow-dark}"
        },
        "shadow-edge": {
          "light": "{palette.brutalista-shadow-edge-light}",
          "dark": "{palette.brutalista-shadow-edge-dark}"
        },
        "surface-blur": {
          "light": 0,
          "dark": 0
        },
        "suggestion-opacity": {
          "light": 0.8,
          "dark": 0.8
        }
      },
      "shadow": {
        "container": "{shadow.hard}",
        "notice": "{shadow.hard}"
      },
      "radius": {
        "container": "{radius.xl}",
        "notice": "{radius.lg}",
        "swatch": "{radius.sm}",
        "badge": "{radius.md}",
        "row": "{radius.md}"
      },
      "border": {
        "container": 3,
        "swatch": 2,
        "notice": 3
      },
      "space": {
        "padding": "{space.14}",
        "block-gap": "{space.10}",
        "range-gap": "{space.8}",
        "range-line-gap": "{space.5}",
        "entry-gap": "{space.8}",
        "inline-gap": "{space.8}",
        "row-gap": "{space.4}",
        "name-gap": "{space.2}",
        "swatch-gap": "{space.10}",
        "swatch-inner-gap": "{space.6}",
        "badge-x": "{space.6}",
        "badge-y": "{space.2}",
        "notice-x": "{space.12}",
        "notice-y": "{space.8}",
        "row-pad-x": "{space.6}",
        "row-pad-y": "{space.3}",
        "meta-gap": "{space.3}"
      }
    }
  }
}
