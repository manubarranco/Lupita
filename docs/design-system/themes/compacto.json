{
  "id": "compacto",
  "name": "Compacto",
  "blurb": "Lo más denso que sigue siendo legible: ancho mínimo, espacios cortos, esquinas mínimas y una sombra apenas insinuada. Para quien lo ve cien veces al día.",
  "axes": [
    "type",
    "color",
    "shape",
    "space",
    "shadow"
  ],
  "overrides": {
    "primitive": {
      "palette": {
        "compacto-surface-light": "#F4F4F6F5",
        "compacto-surface-dark": "#242426F5",
        "compacto-notice-surface-light": "#F4F4F6F5",
        "compacto-notice-surface-dark": "#242426F5",
        "compacto-border-light": "#00000026",
        "compacto-border-dark": "#FFFFFF2E",
        "compacto-text-primary-light": "#101012",
        "compacto-text-primary-dark": "#F2F2F5",
        "compacto-text-secondary-light": "#4D4D55",
        "compacto-text-secondary-dark": "#B4B4BE",
        "compacto-text-accent-light": "#0050C8",
        "compacto-text-accent-dark": "#7DB0FF",
        "compacto-badge-bg-light": "#0000001A",
        "compacto-badge-bg-dark": "#FFFFFF1F",
        "compacto-badge-fg-light": "#101012",
        "compacto-badge-fg-dark": "#F2F2F5",
        "compacto-origin-bg-light": "#FF950033",
        "compacto-origin-bg-dark": "#FF9F0A33",
        "compacto-origin-fg-light": "#4A2A00",
        "compacto-origin-fg-dark": "#FFD9A3",
        "compacto-swatch-border-light": "#000000A6",
        "compacto-swatch-border-dark": "#FFFFFF66",
        "compacto-row-hover-light": "#0050C814",
        "compacto-row-hover-dark": "#7DB0FF1F",
        "compacto-shadow-light": "#00000024",
        "compacto-shadow-dark": "#00000080",
        "compacto-shadow-edge-light": "#0000001A",
        "compacto-shadow-edge-dark": "#00000040"
      }
    },
    "semantic": {
      "text": {
        "title": {
          "size": "{font.size.md}",
          "weight": "{font.weight.semibold}",
          "lineHeight": 1.2
        },
        "id": {
          "size": "{font.size.sm}",
          "lineHeight": 1.15
        },
        "placeholder": {
          "size": "{font.size.md}",
          "lineHeight": 1.15
        },
        "description": {
          "lineHeight": 1.3
        },
        "repo": {
          "lineHeight": 1.15
        },
        "location": {
          "lineHeight": 1.15
        },
        "badge": {
          "lineHeight": 1.15
        },
        "eyebrow": {
          "lineHeight": 1.15
        },
        "footnote": {
          "lineHeight": 1.15
        },
        "swatch": {
          "lineHeight": 1.15
        },
        "notice": {
          "lineHeight": 1.15
        }
      },
      "color": {
        "surface": {
          "light": "{palette.compacto-surface-light}",
          "dark": "{palette.compacto-surface-dark}"
        },
        "notice-surface": {
          "light": "{palette.compacto-notice-surface-light}",
          "dark": "{palette.compacto-notice-surface-dark}"
        },
        "border": {
          "light": "{palette.compacto-border-light}",
          "dark": "{palette.compacto-border-dark}"
        },
        "text-primary": {
          "light": "{palette.compacto-text-primary-light}",
          "dark": "{palette.compacto-text-primary-dark}"
        },
        "text-secondary": {
          "light": "{palette.compacto-text-secondary-light}",
          "dark": "{palette.compacto-text-secondary-dark}"
        },
        "text-accent": {
          "light": "{palette.compacto-text-accent-light}",
          "dark": "{palette.compacto-text-accent-dark}"
        },
        "badge-bg": {
          "light": "{palette.compacto-badge-bg-light}",
          "dark": "{palette.compacto-badge-bg-dark}"
        },
        "badge-fg": {
          "light": "{palette.compacto-badge-fg-light}",
          "dark": "{palette.compacto-badge-fg-dark}"
        },
        "origin-bg": {
          "light": "{palette.compacto-origin-bg-light}",
          "dark": "{palette.compacto-origin-bg-dark}"
        },
        "origin-fg": {
          "light": "{palette.compacto-origin-fg-light}",
          "dark": "{palette.compacto-origin-fg-dark}"
        },
        "swatch-border": {
          "light": "{palette.compacto-swatch-border-light}",
          "dark": "{palette.compacto-swatch-border-dark}"
        },
        "row-hover": {
          "light": "{palette.compacto-row-hover-light}",
          "dark": "{palette.compacto-row-hover-dark}"
        },
        "shadow": {
          "light": "{palette.compacto-shadow-light}",
          "dark": "{palette.compacto-shadow-dark}"
        },
        "shadow-edge": {
          "light": "{palette.compacto-shadow-edge-light}",
          "dark": "{palette.compacto-shadow-edge-dark}"
        },
        "surface-blur": {
          "light": 12,
          "dark": 12
        },
        "suggestion-opacity": {
          "light": 0.75,
          "dark": 0.75
        }
      },
      "shadow": {
        "container": "{shadow.sm}",
        "notice": "{shadow.sm}"
      },
      "radius": {
        "container": "{radius.xs}",
        "notice": "{radius.xs}",
        "swatch": "{radius.xs}",
        "badge": "{radius.xs}",
        "row": "{radius.xs}"
      },
      "border": {
        "container": 1,
        "swatch": 1,
        "notice": 1
      },
      "space": {
        "padding": "{space.8}",
        "block-gap": "{space.8}",
        "range-gap": "{space.5}",
        "range-line-gap": "{space.3}",
        "entry-gap": "{space.6}",
        "inline-gap": "{space.5}",
        "row-gap": "{space.3}",
        "name-gap": "{space.1}",
        "swatch-gap": "{space.6}",
        "swatch-inner-gap": "{space.4}",
        "badge-x": "{space.4}",
        "badge-y": "{space.1}",
        "notice-x": "{space.8}",
        "notice-y": "{space.5}",
        "row-pad-x": "{space.4}",
        "row-pad-y": "{space.2}",
        "meta-gap": "{space.2}"
      },
      "size": {
        "width": 360,
        "swatch": 16
      }
    }
  }
}
