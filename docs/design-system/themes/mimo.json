{
  "id": "mimo",
  "name": "Mimo",
  "blurb": "Tipografía redondeada, pastel y cápsulas generosas. Amable sin ser infantil: la jerarquía sigue mandando.",
  "axes": [
    "type",
    "color",
    "shape",
    "space",
    "shadow"
  ],
  "overrides": {
    "primitive": {
      "palette": {
        "mimo-surface-light": "#FFF5FAF7",
        "mimo-surface-dark": "#2A2036F7",
        "mimo-notice-surface-light": "#FFF5FAF7",
        "mimo-notice-surface-dark": "#2A2036F7",
        "mimo-border-light": "#F2A9D2",
        "mimo-border-dark": "#7A5AA0",
        "mimo-text-primary-light": "#3B2A4D",
        "mimo-text-primary-dark": "#FDEBFF",
        "mimo-text-secondary-light": "#65547A",
        "mimo-text-secondary-dark": "#D5C3E4",
        "mimo-text-accent-light": "#B01E7E",
        "mimo-text-accent-dark": "#FF8AD4",
        "mimo-badge-bg-light": "#FFD1E8",
        "mimo-badge-bg-dark": "#5A3A7A",
        "mimo-badge-fg-light": "#5A1040",
        "mimo-badge-fg-dark": "#FFE6F6",
        "mimo-origin-bg-light": "#CDEBFF",
        "mimo-origin-bg-dark": "#2D5C7A",
        "mimo-origin-fg-light": "#0B3B5C",
        "mimo-origin-fg-dark": "#E6F6FF",
        "mimo-swatch-border-light": "#B01E7ECC",
        "mimo-swatch-border-dark": "#FF8AD499",
        "mimo-row-hover-light": "#FFD1E899",
        "mimo-row-hover-dark": "#5A3A7A99",
        "mimo-shadow-light": "#B01E7E2E",
        "mimo-shadow-dark": "#00000099",
        "mimo-shadow-edge-light": "#B01E7E14",
        "mimo-shadow-edge-dark": "#00000040"
      },
      "shadow": {
        "pop": [
          {
            "x": 0,
            "y": 6,
            "blur": 0,
            "spread": 0,
            "color": "{color.shadow-edge}"
          },
          {
            "x": 0,
            "y": 14,
            "blur": 28,
            "spread": 0,
            "color": "{color.shadow}"
          }
        ]
      }
    },
    "semantic": {
      "text": {
        "title": {
          "family": "{font.family.rounded}",
          "size": "{font.size.xl}",
          "weight": "{font.weight.semibold}",
          "lineHeight": 1.3
        },
        "id": {
          "color": "{color.text-accent}",
          "lineHeight": 1.3
        },
        "description": {
          "family": "{font.family.rounded}",
          "size": "{font.size.lg}",
          "lineHeight": 1.3
        },
        "placeholder": {
          "family": "{font.family.rounded}",
          "lineHeight": 1.3
        },
        "repo": {
          "family": "{font.family.rounded}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.bold}",
          "lineHeight": 1.3
        },
        "location": {
          "size": "{font.size.sm}",
          "lineHeight": 1.3
        },
        "badge": {
          "family": "{font.family.rounded}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.bold}",
          "lineHeight": 1.3
        },
        "eyebrow": {
          "family": "{font.family.rounded}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.medium}",
          "lineHeight": 1.3
        },
        "footnote": {
          "family": "{font.family.rounded}",
          "size": "{font.size.sm}",
          "lineHeight": 1.3
        },
        "swatch": {
          "size": "{font.size.sm}",
          "lineHeight": 1.3
        },
        "notice": {
          "family": "{font.family.rounded}",
          "size": "{font.size.lg}",
          "lineHeight": 1.3
        }
      },
      "color": {
        "surface": {
          "light": "{palette.mimo-surface-light}",
          "dark": "{palette.mimo-surface-dark}"
        },
        "notice-surface": {
          "light": "{palette.mimo-notice-surface-light}",
          "dark": "{palette.mimo-notice-surface-dark}"
        },
        "border": {
          "light": "{palette.mimo-border-light}",
          "dark": "{palette.mimo-border-dark}"
        },
        "text-primary": {
          "light": "{palette.mimo-text-primary-light}",
          "dark": "{palette.mimo-text-primary-dark}"
        },
        "text-secondary": {
          "light": "{palette.mimo-text-secondary-light}",
          "dark": "{palette.mimo-text-secondary-dark}"
        },
        "text-accent": {
          "light": "{palette.mimo-text-accent-light}",
          "dark": "{palette.mimo-text-accent-dark}"
        },
        "badge-bg": {
          "light": "{palette.mimo-badge-bg-light}",
          "dark": "{palette.mimo-badge-bg-dark}"
        },
        "badge-fg": {
          "light": "{palette.mimo-badge-fg-light}",
          "dark": "{palette.mimo-badge-fg-dark}"
        },
        "origin-bg": {
          "light": "{palette.mimo-origin-bg-light}",
          "dark": "{palette.mimo-origin-bg-dark}"
        },
        "origin-fg": {
          "light": "{palette.mimo-origin-fg-light}",
          "dark": "{palette.mimo-origin-fg-dark}"
        },
        "swatch-border": {
          "light": "{palette.mimo-swatch-border-light}",
          "dark": "{palette.mimo-swatch-border-dark}"
        },
        "row-hover": {
          "light": "{palette.mimo-row-hover-light}",
          "dark": "{palette.mimo-row-hover-dark}"
        },
        "shadow": {
          "light": "{palette.mimo-shadow-light}",
          "dark": "{palette.mimo-shadow-dark}"
        },
        "shadow-edge": {
          "light": "{palette.mimo-shadow-edge-light}",
          "dark": "{palette.mimo-shadow-edge-dark}"
        },
        "surface-blur": {
          "light": 0,
          "dark": 0
        },
        "suggestion-opacity": {
          "light": 0.75,
          "dark": 0.75
        }
      },
      "shadow": {
        "container": "{shadow.pop}",
        "notice": "{shadow.pop}"
      },
      "radius": {
        "container": "{radius.2xl}",
        "notice": "{radius.xl}",
        "swatch": "{radius.xl}",
        "badge": "{radius.pill}"
      },
      "border": {
        "container": 2,
        "swatch": 2,
        "notice": 2
      },
      "space": {
        "padding": "{space.16}",
        "block-gap": "{space.12}",
        "range-gap": "{space.10}",
        "range-line-gap": "{space.6}",
        "entry-gap": "{space.10}",
        "inline-gap": "{space.8}",
        "row-gap": "{space.5}",
        "name-gap": "{space.3}",
        "swatch-gap": "{space.12}",
        "swatch-inner-gap": "{space.6}",
        "badge-x": "{space.8}",
        "badge-y": "{space.3}",
        "notice-x": "{space.16}",
        "notice-y": "{space.10}"
      },
      "size": {
        "width": 440
      }
    }
  }
}
