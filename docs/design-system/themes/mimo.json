{
  "id": "mimo",
  "name": "Mimo",
  "blurb": "Una interfaz de juego: tarjeta turquesa como un botón, borde y canto inferior grueso del mismo turquesa más oscuro, esquinas generosas y letra redondeada gruesa. Las insignias, blancas como fichas. Amable sin ser infantil: la jerarquía sigue mandando.",
  "axes": [
    "type",
    "color",
    "shape",
    "space",
    "shadow"
  ],
  "overrides": {
    "primitive": {
      "palette": {
        "mimo-surface-light": "#5ED6CB",
        "mimo-surface-dark": "#3FBFB3",
        "mimo-notice-surface-light": "#5ED6CB",
        "mimo-notice-surface-dark": "#3FBFB3",
        "mimo-border-light": "#2BAA9E",
        "mimo-border-dark": "#1E8F84",
        "mimo-text-primary-light": "#04302D",
        "mimo-text-primary-dark": "#04302D",
        "mimo-text-secondary-light": "#0C4A45",
        "mimo-text-secondary-dark": "#073F3A",
        "mimo-text-accent-light": "#00504A",
        "mimo-text-accent-dark": "#003F3A",
        "mimo-badge-bg-light": "#FFFFFF",
        "mimo-badge-bg-dark": "#FFFFFF",
        "mimo-badge-fg-light": "#00504A",
        "mimo-badge-fg-dark": "#00504A",
        "mimo-origin-bg-light": "#FFE08A",
        "mimo-origin-bg-dark": "#FFE08A",
        "mimo-origin-fg-light": "#4A3200",
        "mimo-origin-fg-dark": "#4A3200",
        "mimo-swatch-border-light": "#04302DCC",
        "mimo-swatch-border-dark": "#04302DCC",
        "mimo-row-hover-light": "#8EE6DE",
        "mimo-row-hover-dark": "#5FD3C8",
        "mimo-shadow-light": "#1F968B",
        "mimo-shadow-dark": "#167A71",
        "mimo-shadow-edge-light": "#1F968B",
        "mimo-shadow-edge-dark": "#167A71"
      },
      "shadow": {
        "pop": [
          {
            "x": 0,
            "y": 5,
            "blur": 0,
            "spread": 0,
            "color": "{color.shadow-edge}"
          }
        ]
      }
    },
    "semantic": {
      "text": {
        "title": {
          "family": "{font.family.rounded}",
          "size": "{font.size.xl}",
          "weight": "{font.weight.semibold}",
          "lineHeight": 1.3
        },
        "id": {
          "color": "{color.text-accent}",
          "lineHeight": 1.3
        },
        "description": {
          "family": "{font.family.rounded}",
          "size": "{font.size.lg}",
          "lineHeight": 1.45
        },
        "placeholder": {
          "family": "{font.family.rounded}",
          "lineHeight": 1.3
        },
        "repo": {
          "family": "{font.family.rounded}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.bold}",
          "lineHeight": 1.3
        },
        "location": {
          "size": "{font.size.sm}",
          "lineHeight": 1.3
        },
        "badge": {
          "family": "{font.family.rounded}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.bold}",
          "lineHeight": 1.3
        },
        "eyebrow": {
          "family": "{font.family.rounded}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.bold}",
          "color": "{color.text-accent}",
          "tracking": 0.4,
          "lineHeight": 1.3
        },
        "footnote": {
          "family": "{font.family.rounded}",
          "size": "{font.size.sm}",
          "lineHeight": 1.3
        },
        "swatch": {
          "size": "{font.size.sm}",
          "lineHeight": 1.3
        },
        "notice": {
          "family": "{font.family.rounded}",
          "size": "{font.size.lg}",
          "lineHeight": 1.3
        }
      },
      "color": {
        "surface": {
          "light": "{palette.mimo-surface-light}",
          "dark": "{palette.mimo-surface-dark}"
        },
        "notice-surface": {
          "light": "{palette.mimo-notice-surface-light}",
          "dark": "{palette.mimo-notice-surface-dark}"
        },
        "border": {
          "light": "{palette.mimo-border-light}",
          "dark": "{palette.mimo-border-dark}"
        },
        "text-primary": {
          "light": "{palette.mimo-text-primary-light}",
          "dark": "{palette.mimo-text-primary-dark}"
        },
        "text-secondary": {
          "light": "{palette.mimo-text-secondary-light}",
          "dark": "{palette.mimo-text-secondary-dark}"
        },
        "text-accent": {
          "light": "{palette.mimo-text-accent-light}",
          "dark": "{palette.mimo-text-accent-dark}"
        },
        "badge-bg": {
          "light": "{palette.mimo-badge-bg-light}",
          "dark": "{palette.mimo-badge-bg-dark}"
        },
        "badge-fg": {
          "light": "{palette.mimo-badge-fg-light}",
          "dark": "{palette.mimo-badge-fg-dark}"
        },
        "origin-bg": {
          "light": "{palette.mimo-origin-bg-light}",
          "dark": "{palette.mimo-origin-bg-dark}"
        },
        "origin-fg": {
          "light": "{palette.mimo-origin-fg-light}",
          "dark": "{palette.mimo-origin-fg-dark}"
        },
        "swatch-border": {
          "light": "{palette.mimo-swatch-border-light}",
          "dark": "{palette.mimo-swatch-border-dark}"
        },
        "row-hover": {
          "light": "{palette.mimo-row-hover-light}",
          "dark": "{palette.mimo-row-hover-dark}"
        },
        "shadow": {
          "light": "{palette.mimo-shadow-light}",
          "dark": "{palette.mimo-shadow-dark}"
        },
        "shadow-edge": {
          "light": "{palette.mimo-shadow-edge-light}",
          "dark": "{palette.mimo-shadow-edge-dark}"
        },
        "surface-blur": {
          "light": 0,
          "dark": 0
        },
        "suggestion-opacity": {
          "light": 0.75,
          "dark": 0.75
        }
      },
      "shadow": {
        "container": "{shadow.pop}",
        "notice": "{shadow.pop}"
      },
      "radius": {
        "container": "{radius.2xl}",
        "notice": "{radius.xl}",
        "swatch": "{radius.md}",
        "badge": "{radius.lg}",
        "row": "{radius.lg}"
      },
      "border": {
        "container": 2,
        "swatch": 2,
        "notice": 2
      },
      "space": {
        "padding": "{space.16}",
        "block-gap": "{space.12}",
        "range-gap": "{space.10}",
        "range-line-gap": "{space.6}",
        "entry-gap": "{space.10}",
        "inline-gap": "{space.8}",
        "row-gap": "{space.5}",
        "name-gap": "{space.3}",
        "swatch-gap": "{space.12}",
        "swatch-inner-gap": "{space.6}",
        "badge-x": "{space.8}",
        "badge-y": "{space.3}",
        "notice-x": "{space.16}",
        "notice-y": "{space.10}",
        "row-pad-x": "{space.8}",
        "row-pad-y": "{space.4}",
        "meta-gap": "{space.4}"
      },
      "size": {
        "width": 440
      }
    }
  }
}
