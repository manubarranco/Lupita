{
  "id": "mimo",
  "name": "Mimo",
  "blurb": "Una interfaz de juego: tarjeta cian clara como un botón, con un borde cian bien marcado y un canto inferior grueso del mismo cian más oscuro; en oscuro, la tarjeta pasa a azul petróleo, esquinas generosas y letra redondeada gruesa. Las insignias, blancas como fichas. Amable sin ser infantil: la jerarquía sigue mandando.",
  "axes": [
    "type",
    "color",
    "shape",
    "space",
    "shadow"
  ],
  "overrides": {
    "primitive": {
      "palette": {
        "mimo-surface-light": "#D2F3FC",
        "mimo-surface-dark": "#163A47",
        "mimo-notice-surface-light": "#D2F3FC",
        "mimo-notice-surface-dark": "#163A47",
        "mimo-border-light": "#16A5C7",
        "mimo-border-dark": "#2BB8DA",
        "mimo-text-primary-light": "#032F3C",
        "mimo-text-primary-dark": "#E6FAFF",
        "mimo-text-secondary-light": "#0A4757",
        "mimo-text-secondary-dark": "#A8DCEA",
        "mimo-text-accent-light": "#006A82",
        "mimo-text-accent-dark": "#5FD8F5",
        "mimo-badge-bg-light": "#FFFFFF",
        "mimo-badge-bg-dark": "#E6FAFF",
        "mimo-badge-fg-light": "#004F63",
        "mimo-badge-fg-dark": "#004F63",
        "mimo-origin-bg-light": "#FFE08A",
        "mimo-origin-bg-dark": "#FFE08A",
        "mimo-origin-fg-light": "#4A3200",
        "mimo-origin-fg-dark": "#4A3200",
        "mimo-swatch-border-light": "#032F3CCC",
        "mimo-swatch-border-dark": "#A8DCEACC",
        "mimo-row-hover-light": "#A8E8F8",
        "mimo-row-hover-dark": "#1F4F5F",
        "mimo-shadow-light": "#1597B8",
        "mimo-shadow-dark": "#0E7895",
        "mimo-shadow-edge-light": "#1597B8",
        "mimo-shadow-edge-dark": "#0E7895"
      },
      "shadow": {
        "pop": [
          {
            "x": 0,
            "y": 5,
            "blur": 0,
            "spread": 0,
            "color": "{color.shadow-edge}"
          }
        ]
      }
    },
    "semantic": {
      "text": {
        "title": {
          "family": "{font.family.rounded}",
          "size": "{font.size.xl}",
          "weight": "{font.weight.semibold}",
          "lineHeight": 1.3
        },
        "id": {
          "color": "{color.text-accent}",
          "lineHeight": 1.3
        },
        "description": {
          "family": "{font.family.rounded}",
          "size": "{font.size.lg}",
          "lineHeight": 1.45
        },
        "placeholder": {
          "family": "{font.family.rounded}",
          "lineHeight": 1.3
        },
        "repo": {
          "family": "{font.family.rounded}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.bold}",
          "lineHeight": 1.3
        },
        "location": {
          "size": "{font.size.sm}",
          "lineHeight": 1.3
        },
        "badge": {
          "family": "{font.family.rounded}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.bold}",
          "lineHeight": 1.3
        },
        "eyebrow": {
          "family": "{font.family.rounded}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.bold}",
          "color": "{color.text-accent}",
          "tracking": 0.4,
          "lineHeight": 1.3
        },
        "footnote": {
          "family": "{font.family.rounded}",
          "size": "{font.size.sm}",
          "lineHeight": 1.3
        },
        "swatch": {
          "size": "{font.size.sm}",
          "lineHeight": 1.3
        },
        "notice": {
          "family": "{font.family.rounded}",
          "size": "{font.size.lg}",
          "lineHeight": 1.3
        }
      },
      "color": {
        "surface": {
          "light": "{palette.mimo-surface-light}",
          "dark": "{palette.mimo-surface-dark}"
        },
        "notice-surface": {
          "light": "{palette.mimo-notice-surface-light}",
          "dark": "{palette.mimo-notice-surface-dark}"
        },
        "border": {
          "light": "{palette.mimo-border-light}",
          "dark": "{palette.mimo-border-dark}"
        },
        "text-primary": {
          "light": "{palette.mimo-text-primary-light}",
          "dark": "{palette.mimo-text-primary-dark}"
        },
        "text-secondary": {
          "light": "{palette.mimo-text-secondary-light}",
          "dark": "{palette.mimo-text-secondary-dark}"
        },
        "text-accent": {
          "light": "{palette.mimo-text-accent-light}",
          "dark": "{palette.mimo-text-accent-dark}"
        },
        "badge-bg": {
          "light": "{palette.mimo-badge-bg-light}",
          "dark": "{palette.mimo-badge-bg-dark}"
        },
        "badge-fg": {
          "light": "{palette.mimo-badge-fg-light}",
          "dark": "{palette.mimo-badge-fg-dark}"
        },
        "origin-bg": {
          "light": "{palette.mimo-origin-bg-light}",
          "dark": "{palette.mimo-origin-bg-dark}"
        },
        "origin-fg": {
          "light": "{palette.mimo-origin-fg-light}",
          "dark": "{palette.mimo-origin-fg-dark}"
        },
        "swatch-border": {
          "light": "{palette.mimo-swatch-border-light}",
          "dark": "{palette.mimo-swatch-border-dark}"
        },
        "row-hover": {
          "light": "{palette.mimo-row-hover-light}",
          "dark": "{palette.mimo-row-hover-dark}"
        },
        "shadow": {
          "light": "{palette.mimo-shadow-light}",
          "dark": "{palette.mimo-shadow-dark}"
        },
        "shadow-edge": {
          "light": "{palette.mimo-shadow-edge-light}",
          "dark": "{palette.mimo-shadow-edge-dark}"
        },
        "surface-blur": {
          "light": 0,
          "dark": 0
        },
        "suggestion-opacity": {
          "light": 0.75,
          "dark": 0.75
        }
      },
      "shadow": {
        "container": "{shadow.pop}",
        "notice": "{shadow.pop}"
      },
      "radius": {
        "container": "{radius.2xl}",
        "notice": "{radius.xl}",
        "swatch": "{radius.md}",
        "badge": "{radius.lg}",
        "row": "{radius.lg}"
      },
      "border": {
        "container": 2,
        "swatch": 2,
        "notice": 2
      },
      "space": {
        "padding": "{space.16}",
        "block-gap": "{space.12}",
        "range-gap": "{space.10}",
        "range-line-gap": "{space.6}",
        "entry-gap": "{space.10}",
        "inline-gap": "{space.8}",
        "row-gap": "{space.5}",
        "name-gap": "{space.3}",
        "swatch-gap": "{space.12}",
        "swatch-inner-gap": "{space.6}",
        "badge-x": "{space.8}",
        "badge-y": "{space.3}",
        "notice-x": "{space.16}",
        "notice-y": "{space.10}",
        "row-pad-x": "{space.8}",
        "row-pad-y": "{space.4}",
        "meta-gap": "{space.4}"
      },
      "size": {
        "width": 440
      }
    }
  }
}
