{
  "id": "grande",
  "name": "Grande",
  "blurb": "Legibilidad máxima: letra de 13 a 17 pt, contraste AAA, borde grueso, fondo sin transparencia y mucho aire. El tema que no pide esfuerzo.",
  "axes": [
    "type",
    "color",
    "shape",
    "space",
    "shadow"
  ],
  "aaa": true,
  "overrides": {
    "primitive": {
      "palette": {
        "grande-surface-light": "#FFFFFFFF",
        "grande-surface-dark": "#121212FF",
        "grande-notice-surface-light": "#FFFFFFFF",
        "grande-notice-surface-dark": "#121212FF",
        "grande-border-light": "#1A1A1A",
        "grande-border-dark": "#FFFFFF",
        "grande-text-primary-light": "#000000",
        "grande-text-primary-dark": "#FFFFFF",
        "grande-text-secondary-light": "#2E2E2E",
        "grande-text-secondary-dark": "#DCDCDC",
        "grande-text-accent-light": "#003A9E",
        "grande-text-accent-dark": "#A8C8FF",
        "grande-badge-bg-light": "#E3E3E3",
        "grande-badge-bg-dark": "#333333",
        "grande-badge-fg-light": "#000000",
        "grande-badge-fg-dark": "#FFFFFF",
        "grande-origin-bg-light": "#FFE3A3",
        "grande-origin-bg-dark": "#6B4A00",
        "grande-origin-fg-light": "#2E1F00",
        "grande-origin-fg-dark": "#FFF3D6",
        "grande-swatch-border-light": "#1A1A1A",
        "grande-swatch-border-dark": "#FFFFFF",
        "grande-row-hover-light": "#003A9E1F",
        "grande-row-hover-dark": "#A8C8FF29",
        "grande-shadow-light": "#00000040",
        "grande-shadow-dark": "#00000099",
        "grande-shadow-edge-light": "#00000026",
        "grande-shadow-edge-dark": "#00000066"
      }
    },
    "semantic": {
      "text": {
        "title": {
          "size": "{font.size.2xl}",
          "weight": "{font.weight.semibold}",
          "lineHeight": 1.35
        },
        "id": {
          "size": "{font.size.xl}",
          "lineHeight": 1.35
        },
        "description": {
          "size": "{font.size.xl}",
          "color": "{color.text-primary}",
          "lineHeight": 1.35
        },
        "placeholder": {
          "size": "{font.size.xl}",
          "lineHeight": 1.35
        },
        "repo": {
          "size": "{font.size.lg}",
          "weight": "{font.weight.bold}",
          "lineHeight": 1.35
        },
        "location": {
          "size": "{font.size.lg}",
          "lineHeight": 1.35
        },
        "badge": {
          "size": "{font.size.md}",
          "weight": "{font.weight.bold}",
          "lineHeight": 1.35
        },
        "eyebrow": {
          "size": "{font.size.lg}",
          "weight": "{font.weight.medium}",
          "lineHeight": 1.35
        },
        "footnote": {
          "size": "{font.size.lg}",
          "lineHeight": 1.35
        },
        "swatch": {
          "size": "{font.size.lg}",
          "lineHeight": 1.35
        },
        "notice": {
          "size": "{font.size.xl}",
          "color": "{color.text-primary}",
          "lineHeight": 1.35
        }
      },
      "color": {
        "surface": {
          "light": "{palette.grande-surface-light}",
          "dark": "{palette.grande-surface-dark}"
        },
        "notice-surface": {
          "light": "{palette.grande-notice-surface-light}",
          "dark": "{palette.grande-notice-surface-dark}"
        },
        "border": {
          "light": "{palette.grande-border-light}",
          "dark": "{palette.grande-border-dark}"
        },
        "text-primary": {
          "light": "{palette.grande-text-primary-light}",
          "dark": "{palette.grande-text-primary-dark}"
        },
        "text-secondary": {
          "light": "{palette.grande-text-secondary-light}",
          "dark": "{palette.grande-text-secondary-dark}"
        },
        "text-accent": {
          "light": "{palette.grande-text-accent-light}",
          "dark": "{palette.grande-text-accent-dark}"
        },
        "badge-bg": {
          "light": "{palette.grande-badge-bg-light}",
          "dark": "{palette.grande-badge-bg-dark}"
        },
        "badge-fg": {
          "light": "{palette.grande-badge-fg-light}",
          "dark": "{palette.grande-badge-fg-dark}"
        },
        "origin-bg": {
          "light": "{palette.grande-origin-bg-light}",
          "dark": "{palette.grande-origin-bg-dark}"
        },
        "origin-fg": {
          "light": "{palette.grande-origin-fg-light}",
          "dark": "{palette.grande-origin-fg-dark}"
        },
        "swatch-border": {
          "light": "{palette.grande-swatch-border-light}",
          "dark": "{palette.grande-swatch-border-dark}"
        },
        "row-hover": {
          "light": "{palette.grande-row-hover-light}",
          "dark": "{palette.grande-row-hover-dark}"
        },
        "shadow": {
          "light": "{palette.grande-shadow-light}",
          "dark": "{palette.grande-shadow-dark}"
        },
        "shadow-edge": {
          "light": "{palette.grande-shadow-edge-light}",
          "dark": "{palette.grande-shadow-edge-dark}"
        },
        "surface-blur": {
          "light": 0,
          "dark": 0
        },
        "suggestion-opacity": {
          "light": 0.85,
          "dark": 0.85
        }
      },
      "shadow": {
        "container": "{shadow.md}",
        "notice": "{shadow.md}"
      },
      "radius": {
        "container": "{radius.xl}",
        "notice": "{radius.lg}",
        "swatch": "{radius.md}",
        "badge": "{radius.md}"
      },
      "border": {
        "container": 2,
        "swatch": 2,
        "notice": 2
      },
      "space": {
        "padding": "{space.20}",
        "block-gap": "{space.14}",
        "range-gap": "{space.12}",
        "range-line-gap": "{space.8}",
        "entry-gap": "{space.12}",
        "inline-gap": "{space.8}",
        "row-gap": "{space.6}",
        "name-gap": "{space.3}",
        "swatch-gap": "{space.14}",
        "swatch-inner-gap": "{space.8}",
        "badge-x": "{space.8}",
        "badge-y": "{space.3}",
        "notice-x": "{space.16}",
        "notice-y": "{space.12}"
      },
      "size": {
        "width": 520,
        "swatch": 28
      }
    }
  }
}
