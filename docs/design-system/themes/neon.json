{
  "id": "neon",
  "name": "Neón",
  "blurb": "Un rótulo de neón: tubo rosa sobre ciruela profundo en los dos modos, el color cálido de la familia. En claro, una sombra oscura lo asienta y un halo corto del color del tubo lo enciende; en oscuro la luz se derrama alrededor.",
  "axes": [
    "type",
    "color",
    "shape",
    "space",
    "shadow"
  ],
  "overrides": {
    "primitive": {
      "palette": {
        "neon-surface-light": "#1F0D24F7",
        "neon-surface-dark": "#2A1430F2",
        "neon-notice-surface-light": "#1F0D24F7",
        "neon-notice-surface-dark": "#2A1430F2",
        "neon-border-light": "#FF4FB0",
        "neon-border-dark": "#FF4FB0E6",
        "neon-text-primary-light": "#FFF0F8",
        "neon-text-primary-dark": "#FFF0F8",
        "neon-text-secondary-light": "#E7B8D6",
        "neon-text-secondary-dark": "#E7B8D6",
        "neon-text-accent-light": "#FF6EC7",
        "neon-text-accent-dark": "#FF6EC7",
        "neon-badge-bg-light": "#FF4FB026",
        "neon-badge-bg-dark": "#FF4FB026",
        "neon-badge-fg-light": "#FFC2E3",
        "neon-badge-fg-dark": "#FFC2E3",
        "neon-origin-bg-light": "#FFB34733",
        "neon-origin-bg-dark": "#FFB34733",
        "neon-origin-fg-light": "#FFD9A3",
        "neon-origin-fg-dark": "#FFD9A3",
        "neon-swatch-border-light": "#FF6EC7CC",
        "neon-swatch-border-dark": "#FF6EC7CC",
        "neon-row-hover-light": "#FF4FB01F",
        "neon-row-hover-dark": "#FF4FB01F",
        "neon-shadow-light": "#2A0A2266",
        "neon-shadow-dark": "#FF4FB03D",
        "neon-shadow-edge-light": "#FF3EA5F2",
        "neon-shadow-edge-dark": "#FF4FB0B3"
      },
      "shadow": {
        "glow": [
          {
            "x": 0,
            "y": 10,
            "blur": 32,
            "spread": 0,
            "color": "{color.shadow}"
          },
          {
            "x": 0,
            "y": 0,
            "blur": 16,
            "spread": 1,
            "color": "{color.shadow-edge}"
          }
        ]
      }
    },
    "semantic": {
      "text": {
        "title": {
          "size": "{font.size.xl}",
          "weight": "{font.weight.semibold}",
          "lineHeight": 1.3
        },
        "id": {
          "color": "{color.text-accent}",
          "tracking": 0.2
        },
        "description": {
          "size": "{font.size.lg}",
          "lineHeight": 1.45
        },
        "repo": {
          "size": "{font.size.sm}",
          "weight": "{font.weight.bold}",
          "tracking": 0.4
        },
        "location": {
          "size": "{font.size.sm}"
        },
        "badge": {
          "size": "{font.size.sm}",
          "weight": "{font.weight.bold}",
          "tracking": 0.4
        },
        "eyebrow": {
          "size": "{font.size.sm}",
          "weight": "{font.weight.medium}",
          "tracking": 0.3
        },
        "footnote": {
          "size": "{font.size.sm}"
        },
        "swatch": {
          "size": "{font.size.sm}"
        },
        "notice": {
          "size": "{font.size.lg}"
        }
      },
      "color": {
        "surface": {
          "light": "{palette.neon-surface-light}",
          "dark": "{palette.neon-surface-dark}"
        },
        "notice-surface": {
          "light": "{palette.neon-notice-surface-light}",
          "dark": "{palette.neon-notice-surface-dark}"
        },
        "border": {
          "light": "{palette.neon-border-light}",
          "dark": "{palette.neon-border-dark}"
        },
        "text-primary": {
          "light": "{palette.neon-text-primary-light}",
          "dark": "{palette.neon-text-primary-dark}"
        },
        "text-secondary": {
          "light": "{palette.neon-text-secondary-light}",
          "dark": "{palette.neon-text-secondary-dark}"
        },
        "text-accent": {
          "light": "{palette.neon-text-accent-light}",
          "dark": "{palette.neon-text-accent-dark}"
        },
        "badge-bg": {
          "light": "{palette.neon-badge-bg-light}",
          "dark": "{palette.neon-badge-bg-dark}"
        },
        "badge-fg": {
          "light": "{palette.neon-badge-fg-light}",
          "dark": "{palette.neon-badge-fg-dark}"
        },
        "origin-bg": {
          "light": "{palette.neon-origin-bg-light}",
          "dark": "{palette.neon-origin-bg-dark}"
        },
        "origin-fg": {
          "light": "{palette.neon-origin-fg-light}",
          "dark": "{palette.neon-origin-fg-dark}"
        },
        "swatch-border": {
          "light": "{palette.neon-swatch-border-light}",
          "dark": "{palette.neon-swatch-border-dark}"
        },
        "row-hover": {
          "light": "{palette.neon-row-hover-light}",
          "dark": "{palette.neon-row-hover-dark}"
        },
        "shadow": {
          "light": "{palette.neon-shadow-light}",
          "dark": "{palette.neon-shadow-dark}"
        },
        "shadow-edge": {
          "light": "{palette.neon-shadow-edge-light}",
          "dark": "{palette.neon-shadow-edge-dark}"
        },
        "surface-blur": {
          "light": 24,
          "dark": 24
        },
        "suggestion-opacity": {
          "light": 0.7,
          "dark": 0.7
        }
      },
      "shadow": {
        "container": "{shadow.glow}",
        "notice": "{shadow.glow}"
      },
      "radius": {
        "container": "{radius.xl}",
        "notice": "{radius.lg}",
        "swatch": "{radius.md}",
        "badge": "{radius.pill}",
        "row": "{radius.md}"
      },
      "border": {
        "container": 1,
        "swatch": 1,
        "notice": 1
      },
      "space": {
        "padding": "{space.16}",
        "block-gap": "{space.12}",
        "range-gap": "{space.10}",
        "range-line-gap": "{space.6}",
        "entry-gap": "{space.10}",
        "inline-gap": "{space.8}",
        "row-gap": "{space.5}",
        "name-gap": "{space.3}",
        "swatch-gap": "{space.12}",
        "swatch-inner-gap": "{space.6}",
        "badge-x": "{space.8}",
        "badge-y": "{space.2}",
        "notice-x": "{space.14}",
        "notice-y": "{space.10}",
        "row-pad-x": "{space.8}",
        "row-pad-y": "{space.4}",
        "meta-gap": "{space.4}"
      },
      "size": {
        "width": 440
      }
    }
  }
}
