{
  "id": "terminal",
  "name": "Terminal",
  "blurb": "Una pantalla de consola: fósforo verde sobre negro en los dos modos, todo en Monaco (un solo peso: el énfasis lo da el color) y esquinas rectas. En oscuro la pantalla sube un tono y el borde se enciende para despegarse del fondo.",
  "axes": [
    "type",
    "color",
    "shape",
    "space",
    "shadow"
  ],
  "overrides": {
    "primitive": {
      "font": {
        "family": {
          "heading": {
            "primary": "Monaco",
            "fallback": "monospaced"
          },
          "body": {
            "primary": "Monaco",
            "fallback": "monospaced"
          },
          "code": {
            "primary": "Monaco",
            "fallback": "monospaced"
          }
        }
      },
      "palette": {
        "terminal-surface-light": "#060906FA",
        "terminal-surface-dark": "#141A14F7",
        "terminal-notice-surface-light": "#060906FA",
        "terminal-notice-surface-dark": "#141A14F7",
        "terminal-border-light": "#060906",
        "terminal-border-dark": "#3DFF7A66",
        "terminal-text-primary-light": "#D4F7CE",
        "terminal-text-primary-dark": "#D4F7CE",
        "terminal-text-secondary-light": "#86C081",
        "terminal-text-secondary-dark": "#86C081",
        "terminal-text-accent-light": "#3DFF7A",
        "terminal-text-accent-dark": "#3DFF7A",
        "terminal-badge-bg-light": "#3DFF7A26",
        "terminal-badge-bg-dark": "#3DFF7A26",
        "terminal-badge-fg-light": "#9BFFB8",
        "terminal-badge-fg-dark": "#9BFFB8",
        "terminal-origin-bg-light": "#FFB00033",
        "terminal-origin-bg-dark": "#FFB00033",
        "terminal-origin-fg-light": "#FFD27A",
        "terminal-origin-fg-dark": "#FFD27A",
        "terminal-swatch-border-light": "#3DFF7A99",
        "terminal-swatch-border-dark": "#3DFF7A99",
        "terminal-row-hover-light": "#3DFF7A1F",
        "terminal-row-hover-dark": "#3DFF7A1F",
        "terminal-shadow-light": "#00000000",
        "terminal-shadow-dark": "#00000000",
        "terminal-shadow-edge-light": "#00000000",
        "terminal-shadow-edge-dark": "#00000000"
      }
    },
    "semantic": {
      "text": {
        "title": {
          "weight": "{font.weight.regular}",
          "color": "{color.text-accent}",
          "lineHeight": 1.35
        },
        "id": {
          "weight": "{font.weight.regular}",
          "color": "{color.text-accent}",
          "lineHeight": 1.3
        },
        "placeholder": {
          "italic": false,
          "lineHeight": 1.3
        },
        "repo": {
          "weight": "{font.weight.regular}",
          "lineHeight": 1.3
        },
        "badge": {
          "weight": "{font.weight.regular}",
          "lineHeight": 1.3
        },
        "eyebrow": {
          "weight": "{font.weight.regular}",
          "lineHeight": 1.3
        },
        "description": {
          "lineHeight": 1.5
        },
        "location": {
          "lineHeight": 1.3
        },
        "footnote": {
          "lineHeight": 1.3
        },
        "swatch": {
          "lineHeight": 1.3
        },
        "notice": {
          "lineHeight": 1.3
        }
      },
      "color": {
        "surface": {
          "light": "{palette.terminal-surface-light}",
          "dark": "{palette.terminal-surface-dark}"
        },
        "notice-surface": {
          "light": "{palette.terminal-notice-surface-light}",
          "dark": "{palette.terminal-notice-surface-dark}"
        },
        "border": {
          "light": "{palette.terminal-border-light}",
          "dark": "{palette.terminal-border-dark}"
        },
        "text-primary": {
          "light": "{palette.terminal-text-primary-light}",
          "dark": "{palette.terminal-text-primary-dark}"
        },
        "text-secondary": {
          "light": "{palette.terminal-text-secondary-light}",
          "dark": "{palette.terminal-text-secondary-dark}"
        },
        "text-accent": {
          "light": "{palette.terminal-text-accent-light}",
          "dark": "{palette.terminal-text-accent-dark}"
        },
        "badge-bg": {
          "light": "{palette.terminal-badge-bg-light}",
          "dark": "{palette.terminal-badge-bg-dark}"
        },
        "badge-fg": {
          "light": "{palette.terminal-badge-fg-light}",
          "dark": "{palette.terminal-badge-fg-dark}"
        },
        "origin-bg": {
          "light": "{palette.terminal-origin-bg-light}",
          "dark": "{palette.terminal-origin-bg-dark}"
        },
        "origin-fg": {
          "light": "{palette.terminal-origin-fg-light}",
          "dark": "{palette.terminal-origin-fg-dark}"
        },
        "swatch-border": {
          "light": "{palette.terminal-swatch-border-light}",
          "dark": "{palette.terminal-swatch-border-dark}"
        },
        "row-hover": {
          "light": "{palette.terminal-row-hover-light}",
          "dark": "{palette.terminal-row-hover-dark}"
        },
        "shadow": {
          "light": "{palette.terminal-shadow-light}",
          "dark": "{palette.terminal-shadow-dark}"
        },
        "shadow-edge": {
          "light": "{palette.terminal-shadow-edge-light}",
          "dark": "{palette.terminal-shadow-edge-dark}"
        },
        "surface-blur": {
          "light": 0,
          "dark": 0
        },
        "suggestion-opacity": {
          "light": 0.7,
          "dark": 0.7
        }
      },
      "shadow": {
        "container": "{shadow.none}",
        "notice": "{shadow.none}"
      },
      "radius": {
        "container": "{radius.none}",
        "notice": "{radius.none}",
        "swatch": "{radius.none}",
        "badge": "{radius.none}",
        "row": "{radius.none}"
      },
      "border": {
        "container": 1,
        "swatch": 1,
        "notice": 1
      },
      "space": {
        "padding": "{space.12}",
        "block-gap": "{space.8}",
        "range-gap": "{space.6}",
        "range-line-gap": "{space.4}",
        "entry-gap": "{space.8}",
        "inline-gap": "{space.8}",
        "row-gap": "{space.3}",
        "name-gap": "{space.2}",
        "swatch-gap": "{space.8}",
        "swatch-inner-gap": "{space.6}",
        "badge-x": "{space.5}",
        "badge-y": "{space.1}",
        "notice-x": "{space.10}",
        "notice-y": "{space.6}",
        "row-pad-x": "{space.6}",
        "row-pad-y": "{space.3}",
        "meta-gap": "{space.3}"
      }
    }
  }
}
