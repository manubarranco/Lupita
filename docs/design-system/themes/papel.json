{
  "id": "papel",
  "name": "Papel",
  "blurb": "Serif editorial sobre papel cálido: el título se lee como un titular, el resto baja en silencio. Esquinas casi rectas y una sombra de hoja sobre la mesa.",
  "axes": [
    "type",
    "color",
    "shape",
    "space",
    "shadow"
  ],
  "overrides": {
    "primitive": {
      "palette": {
        "papel-surface-light": "#FBF6ECF7",
        "papel-surface-dark": "#2B2620F7",
        "papel-notice-surface-light": "#FBF6ECF7",
        "papel-notice-surface-dark": "#2B2620F7",
        "papel-border-light": "#2A241B33",
        "papel-border-dark": "#F3E9D633",
        "papel-text-primary-light": "#2A241B",
        "papel-text-primary-dark": "#F6EEDD",
        "papel-text-secondary-light": "#645A4C",
        "papel-text-secondary-dark": "#C9BDA8",
        "papel-text-accent-light": "#9A3B14",
        "papel-text-accent-dark": "#F0A27C",
        "papel-badge-bg-light": "#2A241B14",
        "papel-badge-bg-dark": "#F3E9D61F",
        "papel-badge-fg-light": "#2A241B",
        "papel-badge-fg-dark": "#F6EEDD",
        "papel-origin-bg-light": "#C98A1B33",
        "papel-origin-bg-dark": "#E0A63A33",
        "papel-origin-fg-light": "#4F3300",
        "papel-origin-fg-dark": "#FFE6B3",
        "papel-swatch-border-light": "#2A241BB3",
        "papel-swatch-border-dark": "#F3E9D666",
        "papel-row-hover-light": "#9A3B140F",
        "papel-row-hover-dark": "#F0A27C1A",
        "papel-shadow-light": "#3A2A1038",
        "papel-shadow-dark": "#00000099",
        "papel-shadow-edge-light": "#3A2A1014",
        "papel-shadow-edge-dark": "#00000040"
      },
      "shadow": {
        "sheet": [
          {
            "x": 0,
            "y": 1,
            "blur": 2,
            "spread": 0,
            "color": "{color.shadow-edge}"
          },
          {
            "x": 0,
            "y": 8,
            "blur": 20,
            "spread": -2,
            "color": "{color.shadow}"
          }
        ]
      }
    },
    "semantic": {
      "text": {
        "title": {
          "family": "{font.family.serif}",
          "size": "{font.size.xl}",
          "lineHeight": 1.3
        },
        "id": {
          "size": "{font.size.sm}",
          "color": "{color.text-accent}",
          "lineHeight": 1.3
        },
        "description": {
          "family": "{font.family.serif}",
          "size": "{font.size.lg}",
          "lineHeight": 1.3
        },
        "placeholder": {
          "family": "{font.family.serif}",
          "lineHeight": 1.3
        },
        "repo": {
          "size": "{font.size.sm}",
          "tracking": 0.3,
          "lineHeight": 1.3
        },
        "location": {
          "size": "{font.size.sm}",
          "lineHeight": 1.3
        },
        "eyebrow": {
          "family": "{font.family.serif}",
          "size": "{font.size.sm}",
          "italic": true,
          "lineHeight": 1.3
        },
        "footnote": {
          "family": "{font.family.serif}",
          "size": "{font.size.sm}",
          "italic": true,
          "lineHeight": 1.3
        },
        "badge": {
          "size": "{font.size.sm}",
          "tracking": 0.3,
          "lineHeight": 1.3
        },
        "swatch": {
          "size": "{font.size.sm}",
          "lineHeight": 1.3
        },
        "notice": {
          "family": "{font.family.serif}",
          "size": "{font.size.lg}",
          "lineHeight": 1.3
        }
      },
      "color": {
        "surface": {
          "light": "{palette.papel-surface-light}",
          "dark": "{palette.papel-surface-dark}"
        },
        "notice-surface": {
          "light": "{palette.papel-notice-surface-light}",
          "dark": "{palette.papel-notice-surface-dark}"
        },
        "border": {
          "light": "{palette.papel-border-light}",
          "dark": "{palette.papel-border-dark}"
        },
        "text-primary": {
          "light": "{palette.papel-text-primary-light}",
          "dark": "{palette.papel-text-primary-dark}"
        },
        "text-secondary": {
          "light": "{palette.papel-text-secondary-light}",
          "dark": "{palette.papel-text-secondary-dark}"
        },
        "text-accent": {
          "light": "{palette.papel-text-accent-light}",
          "dark": "{palette.papel-text-accent-dark}"
        },
        "badge-bg": {
          "light": "{palette.papel-badge-bg-light}",
          "dark": "{palette.papel-badge-bg-dark}"
        },
        "badge-fg": {
          "light": "{palette.papel-badge-fg-light}",
          "dark": "{palette.papel-badge-fg-dark}"
        },
        "origin-bg": {
          "light": "{palette.papel-origin-bg-light}",
          "dark": "{palette.papel-origin-bg-dark}"
        },
        "origin-fg": {
          "light": "{palette.papel-origin-fg-light}",
          "dark": "{palette.papel-origin-fg-dark}"
        },
        "swatch-border": {
          "light": "{palette.papel-swatch-border-light}",
          "dark": "{palette.papel-swatch-border-dark}"
        },
        "row-hover": {
          "light": "{palette.papel-row-hover-light}",
          "dark": "{palette.papel-row-hover-dark}"
        },
        "shadow": {
          "light": "{palette.papel-shadow-light}",
          "dark": "{palette.papel-shadow-dark}"
        },
        "shadow-edge": {
          "light": "{palette.papel-shadow-edge-light}",
          "dark": "{palette.papel-shadow-edge-dark}"
        },
        "surface-blur": {
          "light": 0,
          "dark": 0
        },
        "suggestion-opacity": {
          "light": 0.78,
          "dark": 0.78
        }
      },
      "shadow": {
        "container": "{shadow.sheet}",
        "notice": "{shadow.sheet}"
      },
      "radius": {
        "container": "{radius.sm}",
        "notice": "{radius.sm}",
        "swatch": "{radius.xs}",
        "badge": "{radius.xs}"
      },
      "border": {
        "container": 1,
        "swatch": 1,
        "notice": 1
      },
      "space": {
        "padding": "{space.18}",
        "block-gap": "{space.12}",
        "range-gap": "{space.10}",
        "range-line-gap": "{space.6}",
        "entry-gap": "{space.10}",
        "inline-gap": "{space.8}",
        "row-gap": "{space.5}",
        "name-gap": "{space.3}",
        "swatch-gap": "{space.12}",
        "swatch-inner-gap": "{space.6}",
        "badge-x": "{space.6}",
        "badge-y": "{space.2}",
        "notice-x": "{space.14}",
        "notice-y": "{space.10}"
      },
      "size": {
        "width": 460
      }
    }
  }
}
