{
  "id": "ind-type",
  "name": "Solo tipografía",
  "blurb": "Cristal con otra letra: Charter en títulos y texto, títulos más pesados. Nada más cambia.",
  "axes": [
    "type"
  ],
  "overrides": {
    "primitive": {
      "font": {
        "family": {
          "heading": {
            "primary": "Charter",
            "fallback": "serif"
          },
          "body": {
            "primary": "Charter",
            "fallback": "serif"
          }
        }
      }
    },
    "semantic": {
      "text": {
        "title": {
          "weight": "{font.weight.bold}"
        }
      }
    }
  }
}
